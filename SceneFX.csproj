<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net35</TargetFramework>
        <AssemblyName>SceneFX</AssemblyName>
        <RootNamespace>SceneFX</RootNamespace>
        <LangVersion>7.3</LangVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Product>SceneFX</Product>
        <Version>2.0.0</Version>
        <ManagedDLLPath>$(MSBuildProgramFiles32)/Steam/steamapps/common/Cities_Skylines/Cities_Data/Managed</ManagedDLLPath>
        <FrameworkPathOverride>$(ManagedDLLPath)</FrameworkPathOverride>
        <AssemblySearchPaths>$(AssemblySearchPaths);$(ManagedDLLPath)</AssemblySearchPaths>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp" />
        <Reference Include="ColossalManaged" />
        <Reference Include="ICities" />
        <Reference Include="UnityEngine" />
        <Reference Include="System.Xml" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="BuiltIns\*.scene.xml" />
        <EmbeddedResource Include="BuiltIns\*.suite.xml" />
    </ItemGroup>

    <Target Name="DeployToModDirectory" AfterTargets="Build">
        <PropertyGroup>
            <DeployDir>$(LOCALAPPDATA)/Colossal Order/Cities_Skylines/Addons/Mods/SceneFX/</DeployDir>
        </PropertyGroup>
        <MakeDir Directories="$(DeployDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
        <ItemGroup>
            <LocaleFiles Include="Locale\*.xml" />
        </ItemGroup>
        <Copy SourceFiles="@(LocaleFiles)" DestinationFolder="$(DeployDir)Locale/" SkipUnchangedFiles="true" />
        <Message Importance="high" Text="Deployed to $(DeployDir)" />
    </Target>

</Project>
